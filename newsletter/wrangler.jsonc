{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nl",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Non-secret defaults. Secrets (APP_PASSWORD, SESSION_SECRET, ANTHROPIC_API_KEY,
  // ECOMAIL_API_KEY) are set with `npx wrangler secret put <NAME>` or in .dev.vars locally.
  "vars": {
    "SHOP_URL": "https://www.svet-pokoju.cz",
    "SHOP_NAME": "Světpokojů.cz",
    "FROM_NAME": "Světpokojů.cz",
    "FROM_EMAIL": "",
    "REPLY_TO": "info@svet-pokoju.cz",
    "DEFAULT_LIST_ID": "",
    // Personal sign-off (trust signal): real name, role and a real photo (square, ≥ 128 px, https)
    "SIGNATURE_NAME": "",
    "SIGNATURE_ROLE": "",
    "SIGNATURE_PHOTO": "",
    // Catalogue built from the sitemap by GitHub Actions (tools/build_catalog.py); bundled copy in public/data/
    "CATALOG_URL": "https://tzahradnik.github.io/svet-pokoju-google-feed/newsletter/"
  }
}
