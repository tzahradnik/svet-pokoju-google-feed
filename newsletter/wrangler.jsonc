{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nl",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // hlas-znacky.md is bundled as plain text and fed to the AI prompt
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // Non-secret defaults. Secrets (APP_PASSWORD, SESSION_SECRET, ANTHROPIC_API_KEY,
  // ECOMAIL_API_KEY) are set with `npx wrangler secret put <NAME>` or in .dev.vars locally.
  "vars": {
    "SHOP_URL": "https://www.svet-pokoju.cz",
    "SHOP_NAME": "Světpokojů.cz",
    "FROM_NAME": "Světpokojů.cz",
    "FROM_EMAIL": "info@email.svet-pokoju.cz",
    "REPLY_TO": "info@svet-pokoju.cz",
    "DEFAULT_LIST_ID": "1",
    // Personal sign-off (trust signal): real name, role and a real photo (square, ≥ 128 px, https)
    "SIGNATURE_NAME": "Tereza ze Světa Pokojů",
    "SIGNATURE_ROLE": "",
    "SIGNATURE_PHOTO": "https://nl.svet-pokoju.workers.dev/img/podpis-tereza.jpg",
    // Catalogue built from the sitemap by GitHub Actions (tools/build_catalog.py); bundled copy in public/data/
    "CATALOG_URL": "https://tzahradnik.github.io/svet-pokoju-google-feed/newsletter/",
    // Login by one-time e-mail code (Cloudflare Access, Zero Trust team royal-limit-1491). Who may sign in is
    // the Access policy "Tým newsletterů"; /navod, /img/* and /changelog.json are public (app "Newslettery: veřejné stránky").
    // With both set, the password login is off and the Worker verifies the Access JWT on every /api/* call.
    "ACCESS_TEAM_DOMAIN": "royal-limit-1491.cloudflareaccess.com",
    "ACCESS_AUD": "b2e93a1fd51e1fd20b748b3d69fa167d31b32d0c5701f41126da9c2d0b4855f6"
  }
}
